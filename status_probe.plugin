
from base_plugin import BasePlugin, HookResult, MenuItemData, MenuItemType

__id__ = "status_probe"
__name__ = "Status Probe"
__description__ = "Telegram user status monitoring"
__version__ = "0.2.1"
__category__ = "tools"
__app_version__ = ">=12.5.1"
__sdk_version__ = ">=1.4.4.3"


class StatusProbe(BasePlugin):

    def on_plugin_load(self):
        self.logger.info("STATUS PROBE: Plugin loaded")

        self.add_hook("TL_updateUserStatus")

        self.add_menu_item(
            MenuItemData(
                menu_type=MenuItemType.PROFILE_ACTION_MENU,
                text="Начать отслеживание",
                on_click=self.handle_profile_click,
                icon="msg_info",
                priority=10,
            )
        )

        self.logger.info("STATUS PROBE: Profile menu item registered")

    def handle_profile_click(self, context):
        self.logger.info("STATUS PROBE: Profile menu clicked")
        self.logger.info("Context type: %s", type(context).__name__)
        self.logger.dump(context)

        try:
            self.logger.info(
                "Context keys: %s",
                list(context.keySet())
            )
        except Exception as e:
            self.logger.info("keySet error: %s", str(e))

        try:
            user = context.get("user")
            self.logger.info("User object: %s", user)
            self.logger.dump(user)

            user_id = getattr(user, "id", None)

            if user_id is None:
                user_id = context.get("userId")

            self.logger.info("Selected user ID: %s", user_id)

        except Exception as e:
            self.logger.warning("Context read error: %s", str(e))

    def on_update_hook(self, update_name, account, update):
        if update_name == "TL_updateUserStatus":
            self.logger.info(
                "STATUS UPDATE: User ID %s",
                update.user_id
            )
            self.logger.dump(update.status)

        return HookResult()

